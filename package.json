{
  "name": "pi-replace-function",
  "version": "0.1.0",
  "description": "pi coding agent extension: replace a whole function by name",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint . && eslint .",
    "fix": "eslint --fix .",
    "check": "tsc --noEmit",
    "verify": "pnpm fmt:check && pnpm lint && pnpm check && pnpm test",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.50.0",
    "typebox": "^1.3.37"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-regexp": "^3.2.0",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,jsonc,md,yml,yaml}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "eslint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
